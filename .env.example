FRUITVISION_MODE=demo
# Modo yolo usa somente pesos locais, sem baixar modelos implicitamente.
YOLO_MODEL=models/yolo11n.pt
YOLO_SEGMENT_MODEL=models/yolo11n-seg.pt
FRUIT_CLASSES=apple,banana,orange
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Recomendado para qualquer acesso compartilhado. Header X-API-Key.
FRUITVISION_API_KEY=
MAX_UPLOAD_MB=25
MAX_VIDEO_FRAMES=300
MAX_VIDEO_SECONDS=30
MAX_IMAGE_PIXELS=12000000
MAX_OUTPUT_FILES=20
